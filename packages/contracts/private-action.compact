// VeilWolf private-action spike
//
// This compiler-enforced privacy slice implements anonymous roster membership
// and private night-action commitments. It deliberately does not claim to
// solve role assignment yet. It proves these properties:
//
// 1. each seat is a hidden, randomized commitment in a Merkle tree;
// 2. a join nullifier stops one per-match secret occupying multiple seats;
// 3. the full roster freezes into a separate assignment phase;
// 4. every member registers exactly one hidden assignment-key commitment;
// 5. night actions require a private Merkle-membership proof;
// 6. only a randomized action commitment reaches the public action tree;
// 7. a round-scoped nullifier prevents the same secret acting twice.

pragma language_version >= 0.26;

import CompactStandardLibrary;

export enum ActionPhase { Lobby, Assignment, Night, Closed }

struct PrivatePlayer {
  playerSecret: Bytes<32>;
  rosterNonce: Bytes<32>;
}

struct PrivateNightAction {
  role: Uint<8>;
  target: Bytes<32>;
  nonce: Bytes<32>;
  playerSecret: Bytes<32>;
  rosterNonce: Bytes<32>;
}

struct PrivateAssignmentKey {
  playerSecret: Bytes<32>;
  rosterNonce: Bytes<32>;
  encryptionPublicKey: Bytes<32>;
  keyNonce: Bytes<32>;
}

struct AssignmentKeyPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  encryptionPublicKey: Bytes<32>;
}

struct AssignmentNullifierPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  playerSecret: Bytes<32>;
}

struct RosterPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  playerSecret: Bytes<32>;
}

struct JoinNullifierPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  playerSecret: Bytes<32>;
}

struct ActionPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  turn: Uint<32>;
  role: Uint<8>;
  target: Bytes<32>;
}

struct NullifierPayload {
  domain: Bytes<32>;
  gameId: Bytes<32>;
  turn: Uint<32>;
  playerSecret: Bytes<32>;
}

export ledger gameId: Bytes<32>;
export ledger turn: Uint<32>;
export ledger phase: ActionPhase;
export ledger rosterSize: Uint<8>;
export ledger rosterCommitments: MerkleTree<10, Bytes<32>>;
export ledger rosterJoinNullifiers: Set<Bytes<32>>;
export ledger assignmentKeyCommitments: MerkleTree<10, Bytes<32>>;
export ledger assignmentNullifiers: Set<Bytes<32>>;
export ledger assignmentKeyCount: Uint<8>;
export ledger actionCommitments: MerkleTree<10, Bytes<32>>;
export ledger actionNullifiers: Set<Bytes<32>>;
export ledger acceptedActionCount: Counter;

witness privatePlayer(): PrivatePlayer;
witness privateAssignmentKey(): PrivateAssignmentKey;
witness privateNightAction(): PrivateNightAction;
witness rosterPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

constructor(initialGameId: Bytes<32>) {
  gameId = disclose(initialGameId);
  turn = 1;
  phase = ActionPhase.Lobby;
  rosterSize = 0;
  assignmentKeyCount = 0;
}

pure circuit rosterCommitment(
  playerSecret: Bytes<32>,
  rosterNonce: Bytes<32>,
  matchId: Bytes<32>
): Bytes<32> {
  const payload = RosterPayload {
    domain: pad(32, "veilwolf:roster-member:v1"),
    gameId: matchId,
    playerSecret: playerSecret,
  };
  return persistentCommit<RosterPayload>(payload, rosterNonce);
}

export circuit joinPrivateRoster(): [] {
  assert(phase == ActionPhase.Lobby, "roster is frozen");
  assert(rosterSize < 9, "roster is full");

  const player = privatePlayer();
  assert(player.playerSecret != default<Bytes<32>>, "player secret cannot be empty");
  assert(player.rosterNonce != default<Bytes<32>>, "roster nonce cannot be empty");

  const commitment = rosterCommitment(
    player.playerSecret,
    player.rosterNonce,
    gameId
  );
  const joinNullifier = persistentHash<JoinNullifierPayload>(
    JoinNullifierPayload {
      domain: pad(32, "veilwolf:roster-join-null:v1"),
      gameId: gameId,
      playerSecret: player.playerSecret,
    }
  );

  assert(
    !rosterJoinNullifiers.member(disclose(joinNullifier)),
    "player already joined"
  );
  rosterJoinNullifiers.insert(disclose(joinNullifier));
  rosterCommitments.insert(commitment);
  rosterSize = disclose((rosterSize + 1) as Uint<8>);
}

export circuit beginRoleAssignment(): [] {
  assert(phase == ActionPhase.Lobby, "roster is already frozen");
  assert(rosterSize == 9, "nine players are required");
  phase = ActionPhase.Assignment;
}

export circuit registerAssignmentKey(): [] {
  assert(phase == ActionPhase.Assignment, "assignment registration is closed");

  const participant = privateAssignmentKey();
  assert(
    participant.encryptionPublicKey != default<Bytes<32>>,
    "encryption public key cannot be empty"
  );
  assert(participant.keyNonce != default<Bytes<32>>, "key nonce cannot be empty");

  const memberCommitment = rosterCommitment(
    participant.playerSecret,
    participant.rosterNonce,
    gameId
  );
  const memberPath = rosterPath(memberCommitment);
  assert(
    rosterCommitments.checkRoot(
      disclose(merkleTreePathRoot<10, Bytes<32>>(memberPath))
    ),
    "not a roster member"
  );

  const nullifier = persistentHash<AssignmentNullifierPayload>(
    AssignmentNullifierPayload {
      domain: pad(32, "veilwolf:assign-key-null:v1"),
      gameId: gameId,
      playerSecret: participant.playerSecret,
    }
  );
  assert(
    !assignmentNullifiers.member(disclose(nullifier)),
    "assignment key already registered"
  );

  const keyCommitment = persistentCommit<AssignmentKeyPayload>(
    AssignmentKeyPayload {
      domain: pad(32, "veilwolf:assign-key:v1"),
      gameId: gameId,
      encryptionPublicKey: participant.encryptionPublicKey,
    },
    participant.keyNonce
  );
  assignmentNullifiers.insert(disclose(nullifier));
  assignmentKeyCommitments.insert(keyCommitment);
  assignmentKeyCount = disclose((assignmentKeyCount + 1) as Uint<8>);
}

export circuit startNight(): [] {
  assert(phase == ActionPhase.Assignment, "role assignment is not active");
  assert(assignmentKeyCount == 9, "nine assignment keys are required");
  phase = ActionPhase.Night;
}

export circuit submitPrivateNightAction(): [] {
  assert(phase == ActionPhase.Night, "night actions are closed");

  const action = privateNightAction();
  assert(action.role >= 1 && action.role <= 3, "role cannot act at night");
  assert(action.target != default<Bytes<32>>, "target cannot be empty");

  const memberCommitment = rosterCommitment(
    action.playerSecret,
    action.rosterNonce,
    gameId
  );
  const memberPath = rosterPath(memberCommitment);
  assert(
    rosterCommitments.checkRoot(
      disclose(merkleTreePathRoot<10, Bytes<32>>(memberPath))
    ),
    "not a roster member"
  );

  const payload = ActionPayload {
    domain: pad(32, "veilwolf:night-action:v1"),
    gameId: gameId,
    turn: turn,
    role: action.role,
    target: action.target,
  };
  const commitment = persistentCommit<ActionPayload>(payload, action.nonce);

  const nullifierPayload = NullifierPayload {
    domain: pad(32, "veilwolf:night-nullifier:v1"),
    gameId: gameId,
    turn: turn,
    playerSecret: action.playerSecret,
  };
  const nullifier = persistentHash<NullifierPayload>(nullifierPayload);

  assert(!actionNullifiers.member(disclose(nullifier)), "already acted this turn");
  actionNullifiers.insert(disclose(nullifier));
  actionCommitments.insert(disclose(commitment));
  acceptedActionCount.increment(1);
}

export circuit closeNight(): [] {
  assert(phase == ActionPhase.Night, "night is already closed");
  phase = ActionPhase.Closed;
}
